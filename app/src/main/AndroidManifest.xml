<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Declared required so Play accepts this as a TV app. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Not required, or Play filters the app off every TV device. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Predictive back is deliberately off. It defaults on at this targetSdk,
        and the log proves the system had already registered an
        OnBackInvokedCallback for our window.

        OnBackInvokedCallback delivers an invocation with no duration, so a long
        press becomes indistinguishable from a short one and the long-press menu
        becomes unreachable. A television has no back gesture, only a key, so
        the animated preview predictive back exists to provide is not something
        a user here can ever see. Nothing is lost; a binding the interface
        depends on is kept.
    -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoMercyBrowser"
        android:usesCleartextTraffic="false">

        <!-- WebView's Safe Browsing check is the component that reports browsing
             activity to Google. This app does not use it. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NoMercyBrowser">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Without LEANBACK_LAUNCHER the app installs and is invisible. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
